// Hosted on Cloudflare Workers (static site). Deploy with `npm run deploy`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bryanhenryon",
  "compatibility_date": "2026-11-18",
  // Main domain: Cloudflare creates the DNS record and the HTTPS certificate.
  // (www.bryanhenryon.com is redirected to it by a Cloudflare redirect rule.)
  "routes": [{ "pattern": "bryanhenryon.com", "custom_domain": true }],
  // No *.workers.dev address or preview URLs: the site only exists on its own domain.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    // Folder generated by `astro build`
    "directory": "./dist",
    // Unknown URL → dist/404.html, with a 404 status
    "not_found_handling": "404-page"
  }
}
