---
import type { Dictionary } from "../i18n";
import Eyebrow from "./Eyebrow.astro";
import CopyEmail from "./react/CopyEmail";

interface Props { t: Dictionary }
const { t } = Astro.props;

/* Contact details */
// Forwarded to the personal inbox by Cloudflare Email Routing
const email = "contact@bryanhenryon.com";
// International format, without "+" or spaces
const whatsapp = "https://wa.me/33769831185";
const instagram = "https://www.instagram.com/bryanhenryon.studio/";
const blobs = [
  "--c:#ff8fc4;--x:-15%;--y:-30%;--tx:20vw;--ty:10vh;--d:14s",
  "--c:#ffd36b;--x:55%;--y:-35%;--tx:-15vw;--ty:15vh;--d:17s",
  "--c:#8fb0ff;--x:40%;--y:40%;--tx:-20vw;--ty:-10vh;--d:15s",
  "--c:#7fe8c6;--x:-20%;--y:45%;--tx:15vw;--ty:-15vh;--d:19s",
];
---
<section id="contact" class="contact">
  <div class="contact__card">
    <div class="contact__bg" aria-hidden="true">
      {blobs.map((style) => <span class="blob" style={style}></span>)}
    </div>
    <span class="contact__star s1" aria-hidden="true">✦</span>
    <span class="contact__star s2" aria-hidden="true">✺</span>
    <span class="contact__star s3" aria-hidden="true">✦</span>

    <Eyebrow color="var(--violet)" html={t.ctEyebrow} />
    <h2 class="contact__title" data-split set:html={t.ctTitle} />
    <p class="contact__sub" data-reveal set:html={t.ctSub} />

    <div class="contact__actions" data-reveal>
      {/* React island: hydrated only when the contact section scrolls into view */}
      <CopyEmail client:visible email={email} copyLabel={t.copy} cursorLabel={t.cCopy} toastLabel={t.toast} />
      <a href={`mailto:${email}`} class="btn btn--grad btn--lg" data-magnetic><span>{t.ctSend}</span><span class="btn__arrow">↗</span></a>
    </div>

    <div class="contact__alt" data-reveal>
      <a href={whatsapp} class="contact__chip" target="_blank" rel="noopener">
        <span class="contact__chip-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 3C6.5 3 2 6.9 2 11.7c0 2.4 1.1 4.6 3 6.2L4 21l3.6-1.6c1.4.5 2.8.7 4.4.7 5.5 0 10-3.9 10-8.7S17.5 3 12 3z" fill="currentColor" /></svg>
        </span>
        <span set:html={t.ctWhatsapp} />
      </a>
      <a href={instagram} class="contact__chip contact__chip--instagram" target="_blank" rel="noopener">
        <span class="contact__chip-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none" /></svg>
        </span>
        <span set:html={t.ctInstagram} />
      </a>
    </div>
  </div>
</section>
