---
import type { Dictionary } from "../i18n";
import { projects } from "../data/projects";
import Eyebrow from "./Eyebrow.astro";
import StancerMock from "./mocks/StancerMock.astro";
import DigiteventMock from "./mocks/DigiteventMock.astro";
import HandyamoMock from "./mocks/HandyamoMock.astro";

interface Props { t: Dictionary }
const { t } = Astro.props;

const visuals = { stancer: StancerMock, digitevent: DigiteventMock, handyamo: HandyamoMock };
---
<section id="work" class="section container">
  <div class="section__head">
    <Eyebrow color="var(--blue)" html={t.workEyebrow} />
    <h2 class="h2" data-split set:html={t.workTitle} />
    <p class="section__sub" data-reveal set:html={t.workSub} />
  </div>

  <div class="stack">
    {projects.map((p, i) => {
      const Visual = visuals[p.visual];
      const num = String(i + 1).padStart(2, "0");
      return (
        <article class="pcard" style={`--i:${i};--c1:${p.colors[0]};--c2:${p.colors[1]}`} data-cursor={t.cView}>
          <div class="pcard__info">
            <span class="pcard__meta" set:html={t[p.meta]} />
            <h3>{p.title}</h3>
            <p set:html={t[p.text]} />
            <a href={p.href} class="btn btn--white" target="_blank" rel="noopener"><span>{t.visitSite}</span><span class="btn__arrow">↗</span></a>
          </div>
          <div class="pcard__visual">
            <Visual t={t} />
            <div class="float-tag" style={p.tagStyle} set:html={t[p.tag]} />
          </div>
          <span class="pcard__big" aria-hidden="true">{num}</span>
        </article>
      );
    })}
  </div>
</section>
