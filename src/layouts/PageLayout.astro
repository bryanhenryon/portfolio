---
/* Simple text page (legal notice…): no loader, no animation scripts.
   Kept out of search engines by default (`noindex`). */
import Head from "../components/Head.astro";
import { locales, otherLang, useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path of the same page in the other language. */
  altPath: string;
}
const { lang, title, description, altPath } = Astro.props;
const t = useTranslations(lang);
const loc = locales[lang];
const alt = otherLang(lang);
---
<!doctype html>
<html lang={loc.htmlLang}>
  <Head title={`${title} · Bryan Henryon`} description={description} noindex>
    <link rel="alternate" hreflang={locales[alt].htmlLang} href={altPath} />
  </Head>
  <body class="page">
    <header class="page__header container">
      <a href={loc.path} class="nav__logo">
        <span class="nav__logo-blob"></span>
        <span>bryan<b>henryon</b></span>
      </a>
      <a href={altPath} class="page__lang" hreflang={locales[alt].htmlLang} lang={locales[alt].htmlLang}>
        {alt === "en" ? "English" : "Français"}
      </a>
    </header>

    <main class="page__main container">
      <h1 class="h2">{title}</h1>
      <div class="prose">
        <slot />
      </div>
      <a href={loc.path} class="btn btn--outline btn--sm page__back">
        <span class="btn__arrow">←</span><span>{lang === "fr" ? "Retour à l'accueil" : "Back to home"}</span>
      </a>
    </main>

    <footer class="page__footer container">© {new Date().getFullYear()} Bryan Henryon · <span set:html={t.madeWith} /></footer>
  </body>
</html>
